# PostgreSQL connection. Railway/Render/most hosts provide this as one string.
DATABASE_URL=postgres://user:password@localhost:5432/millline

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# The exact origin (scheme + domain, no trailing slash) the app is served from.
# Passkeys are bound to this — it MUST match the URL employees actually use.
#   local dev:   http://localhost:3000
#   production:  https://mill.yourcompany.com
ORIGIN=http://localhost:3000
RP_ID=localhost
RP_NAME=Mill Line

PORT=3000

# First admin account, created automatically on first boot if the users table is empty.
BOOTSTRAP_ADMIN_NAME=Plant Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PIN=246810
